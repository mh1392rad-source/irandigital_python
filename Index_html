<script>
    // ===== تابع باز کردن لینک با جاوااسکریپت (همیشه کار می‌کنه) =====
    function openLink(url) {
        console.log('🔄 تلاش برای باز کردن: ' + url);
        try {
            // روش اول: باز کردن در پنجره جدید
            window.open(url, '_blank', 'noopener,noreferrer');
        } catch (error) {
            console.error('❌ خطا در باز کردن با window.open:', error);
            try {
                // روش دوم: تغییر مکان صفحه فعلی
                window.location.href = url;
            } catch (error2) {
                console.error('❌ خطا در باز کردن با location.href:', error2);
                // روش سوم: نمایش پیام به کاربر
                alert('لطفاً لینک زیر را در مرورگر جدید باز کنید:\n' + url);
            }
        }
    }

    // ===== نمایش پیام در کنسول =====
    console.log('✅ سایت IranDigital با موفقیت بارگذاری شد!');
    console.log('📌 لینک‌ها با تابع openLink() باز می‌شن.');
    console.log('🔒 برای حل مشکل فایرفاکس، از پنجره جدید استفاده می‌شود.');
</script>

